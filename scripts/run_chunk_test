#!/usr/bin/env python3
"""Process a single chunk and write it to its own .h5 file.
Usage: run_chunk_test --chunk 0 --num-chunks 100
"""

import argparse
import time
from pathlib import Path

import h5py
import numpy as np
import pandas as pd

import avocado
from dlip_plasticc.config import load_config, apply_avocado_settings
from dlip_plasticc.pipelines.gp_fit import PlasticcGPGridSequenceFeaturizer

# ── config ───────────────────────────────────────────────────────────────────
CONFIG_DEFAULT_PATH = '/home6/s4339150/Courses/dlip_plasticc/configs/default.toml'
CONFIG_LOCAL_PATH   = '/home6/s4339150/Courses/dlip_plasticc/configs/local.toml'
DATASET_NAME        = 'plasticc_test'
CHUNK_DIR           = '/scratch/s4339150/plasticc/data/chunks_test'   # one .h5 per chunk
N_TIMESTEPS         = 200
COMPRESSION         = 'gzip'

parser = argparse.ArgumentParser()
parser.add_argument('--chunk',      type=int, required=True)
parser.add_argument('--num-chunks', type=int, default=500)
args = parser.parse_args()

chunk      = args.chunk
num_chunks = args.num_chunks

# ── setup ────────────────────────────────────────────────────────────────────
cfg = load_config(CONFIG_DEFAULT_PATH, CONFIG_LOCAL_PATH)
apply_avocado_settings(cfg)

chunk_dir = Path(CHUNK_DIR)
chunk_dir.mkdir(parents=True, exist_ok=True)

out_path = chunk_dir / f'chunk_{chunk:04d}.h5'
tmp_path = chunk_dir / f'chunk_{chunk:04d}.tmp.h5'

# skip if already done
if out_path.exists():
    print(f'chunk {chunk} already exists, skipping.')
    raise SystemExit(0)

# ── featurizer ───────────────────────────────────────────────────────────────
gp_featurizer = PlasticcGPGridSequenceFeaturizer(n_timesteps=N_TIMESTEPS)

def raw_gp_to_transformer_arrays(raw_features: pd.DataFrame):
    flux  = np.stack(raw_features['flux'].values).astype(np.float32)
    sigma = np.stack(raw_features['sigma'].values).astype(np.float32)

    n_objects, n_timesteps, n_bands = flux.shape
    if n_timesteps != N_TIMESTEPS:
        raise ValueError(f'Expected {N_TIMESTEPS} timesteps, got {n_timesteps}')
    if n_bands != 6:
        raise ValueError(f'Expected 6 bands, got {n_bands}')

    time_norm = np.linspace(0.0, 1.0, n_timesteps, dtype=np.float32)
    time_norm = np.broadcast_to(time_norm[None, :, None], (n_objects, n_timesteps, 1))

    cont_features = np.concatenate([time_norm, flux, sigma], axis=2).astype(np.float32)
    band_ids      = np.zeros((n_objects, n_timesteps), dtype=np.int64)
    mask          = np.ones( (n_objects, n_timesteps), dtype=np.float32)

    return cont_features, band_ids, mask

# ── process ──────────────────────────────────────────────────────────────────
t0 = time.time()

ds = avocado.load(DATASET_NAME, chunk=chunk, num_chunks=num_chunks, metadata_only=False)
t1 = time.time()
print(f'[chunk {chunk}] avocado.load:         {t1-t0:.1f}s')

ds.extract_raw_features(gp_featurizer)
t2 = time.time()
print(f'[chunk {chunk}] extract_raw_features: {t2-t1:.1f}s')

raw                           = ds.raw_features.copy()
object_id                     = ds.metadata.index.to_numpy()
cont_features, band_ids, mask = raw_gp_to_transformer_arrays(raw)
t3 = time.time()
print(f'[chunk {chunk}] array conversion:     {t3-t2:.1f}s')

# ── write (atomic) ───────────────────────────────────────────────────────────
with h5py.File(tmp_path, 'w') as f:
    f.create_dataset('object_id',     data=object_id.astype('S'), compression=COMPRESSION)
    f.create_dataset('cont_features', data=cont_features,          compression=COMPRESSION)
    f.create_dataset('band_ids',      data=band_ids,               compression=COMPRESSION)
    f.create_dataset('mask',          data=mask,                   compression=COMPRESSION)
    f.attrs['chunk']      = chunk
    f.attrs['num_chunks'] = num_chunks

tmp_path.rename(out_path)
t4 = time.time()
print(f'[chunk {chunk}] write:                {t4-t3:.1f}s')
print(f'[chunk {chunk}] DONE — {cont_features.shape[0]} objects  total={t4-t0:.1f}s')